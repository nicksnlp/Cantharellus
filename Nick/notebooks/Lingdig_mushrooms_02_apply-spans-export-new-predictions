kolay Vorontsov","userId":"13880510067333327661"}}},"execution_count":3,"outputs":[]},{"cell_type":"code","source":["# Paths to the data:\n","path_to_data = \"/content/drive/MyDrive/Colab_Notebooks/Lingdig_mushroom/data/\""],"metadata":{"id":"JrmproD-a2H9","executionInfo":{"status":"ok","timestamp":1730647385238,"user_tz":-120,"elapsed":329,"user":{"displayName":"Nikolay Vorontsov","userId":"13880510067333327661"}}},"execution_count":4,"outputs":[]},{"cell_type":"code","source":["## Filter the validation set: remove the soft labels, hard labels\n","\n","# Define paths for input and output files\n","input_file_path = path_to_data + \"val/mushroom.en-val.v2.jsonl\"\n","unlabled_file_path = path_to_data + \"experiment/mushroom.en-val.v2.unlabeled.jsonl\"\n","output_with_spans_path = path_to_data + \"experiment/mushroom.en-val.v2.new_spans.jsonl\"\n","\n","# Open the input file and create a new output file\n","with open(input_file_path, 'r', encoding='utf-8') as infile, open(unlabled_file_path, 'w', encoding='utf-8') as outfile:\n","    for line in infile:\n","        # Parse each line as a JSON object\n","        data = json.loads(line)\n","\n","        # Filter out the required fields\n","        filtered_entry = {\n","            \"id\": data.get(\"id\", \"\") + \"_unlabeled\",\n","            \"lang\": data.get(\"lang\", \"\"),\n","            \"model_input\": data.get(\"model_input\", \"\"),\n","            \"model_output_text\": data.get(\"model_output_text\", \"\"),\n","            \"model_id\": data.get(\"model_id\", \"\"),\n","            \"soft_labels\": [],\n","            \"hard_labels\": [],\n","            \"model_output_logits\": data.get(\"model_output_logits\", []),\n","            \"model_output_tokens\": data.get(\"model_output_tokens\", [])\n","        }\n","\n","        # Write the filtered entry to the output file in JSONL format\n","        json.dump(filtered_entry, outfile, ensure_ascii=False)\n","        outfile.write('\\n')  # Ensure each entry is on a new line\n","\n","print(f\"Filtered data saved to {unlabled_file_path}\")\n"],"metadata":{"id":"G9b-A7p0G5fb","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1730647388821,"user_tz":-120,"elapsed":1692,"user":{"displayName":"Nikolay Vorontsov","userId":"13880510067333327661"}},"outputId":"0a101cee-858b-468d-8263-145b50203f2a"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Filtered data saved to /content/drive/MyDrive/Colab_Notebooks/Lingdig_mushroom/data/experiment/mushroom.en-val.v2.unlabeled.jsonl\n"]}]},{"cell_type":"code","source":["# Here should be a function that takes a data-point on the input\n","# and outputs for each datapoint soft and hard labels\n","\n","# Define spans with specific probabilities\n","# below are randomly set numbers\n","\n","spans = [\n","    (0, 51, 0.8),    # span from 0 to 51 with a probability of 0.8\n","    (89, 95, 0.9),   # span from 89 to 95 with a probability of 0.9\n","    (100, 110, 1.0)  # span from 100 to 110 with a probability of 1.0\n","]\n","\n","# Function to assign soft_labels and fit them within the text lengths\n","def generate_soft_labels(spans, text_len):\n","    \"\"\"Generates soft labels using known probabilities, ensuring they fit within the bounds of text_len.\"\"\"\n","    soft_labels = []\n","    for start, end, prob in spans:\n","        # Clip the span's end if it exceeds text_len\n","        end = min(end, text_len)\n","\n","        # Only add spans that have a valid range within the text length\n","        if start < text_len and end > start:\n","            soft_labels.append({\n","                \"start\": start,\n","                \"end\": end,\n","                \"prob\": prob  # Use the known probability directly\n","            })\n","    return soft_labels\n","\n","# Function to generate hard labels based on soft labels or original spans\n","def generate_hard_labels(spans, text_len):\n","    \"\"\"Generates hard labels based on the given spans, ensuring they fit within text_len.\"\"\"\n","    hard_labels = []\n","    for start, end, _ in spans:\n","        # Clip the span's end if it exceeds text_len\n","        end = min(end, text_len)\n","\n","        # Only add spans that are valid\n","        if start < text_len and end > start:\n","            hard_labels.append([start, end])  # Append as a list of [start, end]\n","    return hard_labels\n","\n","# Process the filtered data to add soft and hard labels\n","with open(unlabled_file_path, 'r', encoding='utf-8') as infile, open(output_with_spans_path, 'w', encoding='utf-8') as outfile:\n","    for line in infile:\n","        # Parse each line as a JSON object\n","        data = json.loads(line)\n","\n","        # Rename the id\n","        data[\"id\"] = data[\"id\"].replace(\"_unlabeled\", \"\")\n","        data[\"id_2\"] = data[\"id\"] + \"_new-span-prediction\"\n","\n","        # Get the length of the text (assuming data contains a 'model_output_text' field)\n","        text_len = len(data['model_output_text'])\n","\n","        # Apply soft and hard label generation\n","        data[\"soft_labels\"] = generate_soft_labels(spans, text_len)\n","        data[\"hard_labels\"] = generate_hard_labels(spans, text_len)  # Generate hard labels based on the same spans\n","\n","        # Write the modified data back to the output file in JSONL format\n","        json.dump(data, outfile, ensure_ascii=False)\n","        outfile.write('\\n')  # Ensure each entry is on a new line\n","\n","print(f\"Data with new spans saved to {output_with_spans_path}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"PTFYjGeKvAyJ","executionInfo":{"status":"ok","timestamp":1730647406623,"user_tz":-120,"elapsed":906,"user":{"displayName":"Nikolay Vorontsov","userId":"13880510067333327661"}},"outputId":"f9686a4f-79e9-44a2-edf6-d723818f0da0"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["Data with new spans saved to /content/drive/MyDrive/Colab_Notebooks/Lingdig_mushroom/data/experiment/mushroom.en-val.v2.new_spans.jsonl\n"]}]},{"cell_type":"code","source":["## Preview data\n","# Open and read the .jsonl file\n","\n","with open(output_with_spans_path, 'r', encoding='utf-8') as infile:\n","    count = 0\n","    for line in infile:\n","      if count == 0: ## Set a desired output: (the number of the datapoint)-1\n","        preview_data = json.loads(line)\n","        preview_data_pretty_string = json.dumps(preview_data, ensure_ascii=False, indent=4)\n","        print(preview_data_pretty_string)\n","      count += 1\n","    print()\n","    print(f\"the total amount of lines is {count}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"collapsed":true,"id":"sr4R4N5nrPCL","executionInfo":{"status":"ok","timestamp":1730647416851,"user_tz":-120,"elapsed":248,"user":{"displayName":"Nikolay Vorontsov","userId":"13880510067333327661"}},"outputId":"a120e3f7-3496-4994-8db3-cf78dbf54aee"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["{\n","    \"id\": \"val-en-1\",\n","    \"lang\": \"EN\",\n","    \"model_input\": \"What did Petra van Staveren win a gold medal for?\",\n","    \"model_output_text\": \"Petra van Stoveren won a silver medal in the 2008 Summer Olympics in Beijing, China.\",\n","    \"model_id\": \"tiiuae/falcon-7b-instruct\",\n","    \"soft_labels\": [\n","        {\n","            \"start\": 0,\n","            \"end\": 51,\n","            \"prob\": 0.8\n","        }\n","    ],\n","    \"hard_labels\": [\n","        [\n","            0,\n","            51\n","        ]\n","    ],\n","    \"model_output_logits\": [\n","        -5.5669536591,\n","        -11.90533638,\n","        -13.0743436813,\n","        -9.9514026642,\n","        -8.8359375,\n","        -5.2216725349,\n","        -8.8481779099,\n","        -9.2853775024,\n","        -7.6449022293,\n","        -8.7612609863,\n","        -9.1256427765,\n","     
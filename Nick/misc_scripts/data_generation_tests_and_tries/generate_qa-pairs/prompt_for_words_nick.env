Sample3 = "{"id":"val-en-27","lang":"EN","model_input":"Who is the head of the FBI\u2019s White Collar Crimes Unit in the series White Collar?","model_output_text":" In the television series \"White Collar,\" which aired from 2009 to 2014, there isn't a specific character named as the head of the FBI's White Collar Crimes Unit. However, the main protagonist is Neal Caffrey (played by Matt Bomer), who is a former white-collar criminal and art forger who works as a consultant for the FBI in solving white-collar crimes. The agent in charge of overseeing Neal's work is Peter Burke (played by Tim DeKay). So, while Peter Burke isn't the head of the White Collar Crimes Unit per se, he plays a significant role in managing and coordinating the investigations.","model_id":"TheBloke\/Mistral-7B-Instruct-v0.2-GGUF","soft_labels":[{"start":73,"prob":0.4,"end":79},{"start":79,"prob":0.8,"end":84},{"start":84,"prob":0.4,"end":87},{"start":87,"prob":0.5,"end":105},{"start":105,"prob":0.4,"end":111},{"start":111,"prob":0.3,"end":123},{"start":123,"prob":0.2,"end":161},{"start":161,"prob":0.1,"end":163},{"start":163,"prob":0.2,"end":170},{"start":170,"prob":0.1,"end":176},{"start":176,"prob":0.2,"end":208},{"start":208,"prob":0.1,"end":242},{"start":242,"prob":0.2,"end":261},{"start":261,"prob":0.1,"end":275},{"start":275,"prob":0.3,"end":278},{"start":278,"prob":0.2,"end":285},{"start":285,"prob":0.1,"end":379},{"start":379,"prob":0.2,"end":437},{"start":437,"prob":0.1,"end":440},{"start":440,"prob":0.3,"end":444},{"start":444,"prob":0.4,"end":449},{"start":449,"prob":0.2,"end":450},{"start":450,"prob":0.3,"end":462},{"start":462,"prob":0.7,"end":464},{"start":464,"prob":0.8,"end":467},{"start":467,"prob":0.3,"end":508},{"start":508,"prob":0.2,"end":509},{"start":509,"prob":0.5,"end":515},{"start":515,"prob":0.3,"end":592}],"hard_labels":[[79,84],[462,467]],"model_output_logits":[-1.771176815,1.2003889084,4.9117946625,5.6379885674,2.297847271,-1.8418343067,0.3205217123,1.1267676353,
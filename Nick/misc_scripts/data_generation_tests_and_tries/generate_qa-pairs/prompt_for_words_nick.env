Sample1 = "{"id":"val-en-25","lang":"EN","model_input":"In which year were the Gampel and Bratsch municipalities merged?","model_output_text":" I apologize for any confusion, but there seems to be a missing context in your question. Gampel and Bratsch are indeed two municipalities located in the canton of Graub\u00fcnden in Switzerland. However, they were not merged into one single municipality. They have remained separate entities up until now. Therefore, there is no year to provide as an answer for this question.","model_id":"TheBloke\/Mistral-7B-Instruct-v0.2-GGUF","soft_labels":[{"start":1,"prob":0.3,"end":88},{"start":88,"prob":0.2,"end":139},{"start":139,"prob":0.3,"end":164},{"start":164,"prob":0.6,"end":174},{"start":174,"prob":0.2,"end":191},{"start":191,"prob":0.5,"end":200},{"start":200,"prob":0.7,"end":201},{"start":201,"prob":0.8,"end":205},{"start":205,"prob":0.9,"end":210},{"start":210,"prob":1.0,"end":213},{"start":213,"prob":0.9,"end":220},{"start":220,"prob":0.8,"end":256},{"start":256,"prob":0.9,"end":269},{"start":269,"prob":0.8,"end":297},{"start":297,"prob":0.9,"end":300},{"start":300,"prob":0.5,"end":322},{"start":322,"prob":0.7,"end":324},{"start":324,"prob":0.6,"end":353},{"start":353,"prob":0.5,"end":371}],"hard_labels":[[164,174],[200,300],[322,353]],"model_output_logits":[-2.7160224915,2.5984785557,4.4250340462,-0.0401426256,4.8999357224,1.4248942137,2.5504579544,7.110165596,3.0470786095,3.3941643238,5.6566638947,4.6699991226,4.3146996498,3.6979556084,1.6745164394,2.5457193851,7.381775856,0.4504725933,0.6601352692,0.2323981822,0.6746106744,0.1821106076,-0.2700103819,2.9155893326,0.6550412774,1.0950591564,0.9100400209,2.5072152615,-0.2718545198,3.0685625076,6.1032562256,-0.184708029,5.9722480774,4.5378351212,2.778087616,8.6045532227,2.844575882,0.8532615304,3.6318459511,7.5120820999,1.5346515179,2.1976828575,5.317694664,-1.7263258696,1.8144261837,-1.1110435724,7.8092980385,4.1904983521,3.0865340233,4.4971466064,1.0520350933,5.2631168365,5.